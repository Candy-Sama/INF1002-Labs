{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build C with GCC",
			"type": "shell",
			"command": "C:\\w64devkit\\w64devkit\\bin\\gcc.exe",
			"args": [
				"${file}",
				"-o",
				"${fileBasenameNoExtension}.exe"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": ["$gcc"]
		}
	]
}